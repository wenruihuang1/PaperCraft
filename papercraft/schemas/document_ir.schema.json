{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "DocumentSource": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "language": {
          "const": "en",
          "title": "Language",
          "type": "string"
        },
        "input_type": {
          "const": "text_pdf",
          "title": "Input Type",
          "type": "string"
        },
        "page_count": {
          "exclusiveMinimum": 0,
          "title": "Page Count",
          "type": "integer"
        }
      },
      "required": [
        "file_name",
        "sha256",
        "language",
        "input_type",
        "page_count"
      ],
      "title": "DocumentSource",
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "exclusiveMinimum": 0,
          "title": "Page Number",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "page_number",
        "width",
        "height"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "PaperMetadata": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        }
      },
      "required": [
        "title"
      ],
      "title": "PaperMetadata",
      "type": "object"
    },
    "SourceAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^ast_[a-z0-9_]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "enum": [
            "figure",
            "table"
          ],
          "title": "Asset Type",
          "type": "string"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "caption": {
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        }
      },
      "required": [
        "asset_id",
        "asset_type",
        "page",
        "caption",
        "path",
        "bbox"
      ],
      "title": "SourceAsset",
      "type": "object"
    },
    "SourceBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "pattern": "^srcblk_[a-z0-9_]+$",
          "title": "Block Id",
          "type": "string"
        },
        "block_type": {
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list_item",
            "caption"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "section_id": {
          "anyOf": [
            {
              "pattern": "^srcsec_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "block_type",
        "page",
        "text",
        "bbox",
        "reading_order"
      ],
      "title": "SourceBlock",
      "type": "object"
    },
    "SourceEquation": {
      "additionalProperties": false,
      "properties": {
        "source_equation_id": {
          "pattern": "^seq_[a-z0-9_]+$",
          "title": "Source Equation Id",
          "type": "string"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "representation": {
          "enum": [
            "pdf_text",
            "latex"
          ],
          "title": "Representation",
          "type": "string"
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        }
      },
      "required": [
        "source_equation_id",
        "page",
        "representation",
        "raw_text",
        "bbox"
      ],
      "title": "SourceEquation",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "anyOf": [
            {
              "pattern": "^srcblk_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "source_equation_id": {
          "anyOf": [
            {
              "pattern": "^seq_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Equation Id"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^ast_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "page"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_ref_id": {
          "pattern": "^src_[a-z0-9_]+$",
          "title": "Source Ref Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "text_span",
            "equation",
            "figure",
            "table",
            "caption"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "source_ref_id",
        "source_type",
        "locator",
        "quote",
        "checksum"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceSection": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "pattern": "^srcsec_[a-z0-9_]+$",
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "level": {
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "page_start": {
          "exclusiveMinimum": 0,
          "title": "Page Start",
          "type": "integer"
        },
        "page_end": {
          "exclusiveMinimum": 0,
          "title": "Page End",
          "type": "integer"
        }
      },
      "required": [
        "section_id",
        "title",
        "level",
        "page_start",
        "page_end"
      ],
      "title": "SourceSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_revision": {
      "exclusiveMinimum": 0,
      "title": "Artifact Revision",
      "type": "integer"
    },
    "paper_id": {
      "pattern": "^ppr_[a-z0-9_]+$",
      "title": "Paper Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/DocumentSource"
    },
    "metadata": {
      "$ref": "#/$defs/PaperMetadata"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageInfo"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SourceSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/SourceBlock"
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "equations": {
      "items": {
        "$ref": "#/$defs/SourceEquation"
      },
      "title": "Equations",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/SourceAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "artifact_revision",
    "paper_id",
    "source",
    "metadata",
    "pages",
    "sections",
    "blocks",
    "source_refs"
  ],
  "title": "DocumentIR",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papercraft.local/schemas/document_ir.schema.json"
}
